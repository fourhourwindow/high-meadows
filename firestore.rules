rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Set a custom claim on your own Firebase Auth user:
      // admin.auth().setCustomUserClaims(uid, { admin: true })
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public marketing content: units and packages are readable by anyone
    // (needed to render the site + booking flow), writable only by admin.
    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dayOfWeekRates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seasonalAdjustments/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cancellation policy tiers, etc. — nothing sensitive, same pattern as
    // packages/rates: publicly readable, admin-only to change.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Availability is read-only for the public calendar and writable only
    // by an admin (for manually blocking/unblocking a date — see the Admin
    // page) or by Cloud Functions using the Admin SDK, which bypasses these
    // rules entirely regardless of what's written here. Direct writes from
    // a signed-in customer are never allowed.
    match /availability/{unitId}/dates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings contain PII (name, email, phone) — never publicly readable.
    // Creation and all status changes go through Cloud Functions (which use
    // the Admin SDK and bypass these rules), so direct client writes are
    // blocked entirely. Admins can read for the dashboard.
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /changeRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
